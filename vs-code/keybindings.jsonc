// LINK: .config/Code/User (Soft link)
[
	// NOTE: You can only chord 1 key. 
	// ============================================
	// CHAPTER: "Ctrl + space" for important stuff.
	// ============================================
	{
		"key": "ctrl+space b",
		"command": "workbench.action.toggleSidebarVisibility"
	},
	{
		"key": "ctrl+b",
		"command": "-workbench.action.toggleSidebarVisibility"
	},
	{
		"key": "ctrl+space c",
		"command": "workbench.action.toggleAuxiliaryBar" // Copilot bar.
	},
	{
		"key": "ctrl+space p",
		"command": "workbench.action.showCommands"
	},
	{
		"key": "ctrl+shift+p",
		"command": "-workbench.action.showCommands"
	},
	{
		"key": "ctrl+space o",
		"command": "outline.focus"
	},
	{
		"key": "ctrl+space j",
		"command": "workbench.action.togglePanel"
	},
	{
		"key": "ctrl+j",
		"command": "-workbench.action.togglePanel"
	},
	{
		"key": "ctrl+space z",
		"command": "workbench.action.toggleZenMode",
		"when": "!isAuxiliaryWindowFocusedContext"
	},
	{
		"key": "ctrl+space r",
		"command": "editor.action.rename",
		"when": "editorHasRenameProvider && editorTextFocus && !editorReadonly"
	},
	{
		"key": "ctrl+space n",
		"command": "vscode-neovim.restart"
	},
	{
		"key": "ctrl+space f",
		"command": "editor.action.formatDocument",
		"when": "editorTextFocus && !editorReadonly && !inCompositeEditor"
	},
	{
		"key": "ctrl+space f",
		"command": "notebook.formatCell",
		"when": "editorTextFocus && inCompositeEditor && notebookEditable && !editorReadonly"
	},
	{
		"key": "ctrl+space f",
		"command": "notebook.format",
		"when": "notebookEditable && !editorTextFocus && activeEditor == 'workbench.editor.notebook'"
	},
	// ============================================
	// CHAPTER: "Ctrl + /" for telescope.
	// ============================================
	// Unbind native line commenting to free up Ctrl+/ as a prefix key
	{
		"key": "ctrl+/",
		"command": "-editor.action.commentLine",
		"when": "editorTextFocus && !editorReadonly"
	},
	{
		"key": "ctrl+/",
		"command": "-editor.action.accessibleViewAcceptInlineCompletion",
		"when": "accessibleViewIsShown && accessibleViewCurrentProviderId == 'inlineCompletions'"
	},
	{
		"key": "ctrl+/",
		"command": "-notebook.commentSelectedCells",
		"when": "notebookEditable && notebookEditorFocused && !inputFocus"
	},
	// Native replacement
	{
		"key": "ctrl+/ f",
		"command": "workbench.action.quickOpen"
	},
	{
		"key": "ctrl+/ s",
		"command": "workbench.action.gotoSymbol"
	},
	// Telescope
	{
		"key": "ctrl+/ /",
		"command": "code-telescope.fuzzy.fileText"
	},
	{
		"key": "ctrl+/ g",
		"command": "code-telescope.fuzzy.wsText"
	},
	// {
	// 	"key": "ctrl+/ s",
	// 	"command": "code-telescope.fuzzy.documentSymbols"
	// },
	{
		"key": "ctrl+/ shift+s",
		"command": "code-telescope.fuzzy.wsSymbols"
	},
	{
		"key": "ctrl+/ r",
		"command": "code-telescope.fuzzy.recentFiles"
	},
	// ============================================
	// CHAPTER: JUPYTER NOTEBOOKS (List focus)
	// ============================================
	// Move cell UP and DOWN
	{
		"key": "shift+j",
		"command": "notebook.cell.moveDown",
		"when": "notebookEditorFocused && !inputFocus && !notebookOutputInputFocused"
	},
	{
		"key": "shift+k",
		"command": "notebook.cell.moveUp",
		"when": "notebookEditorFocused && !inputFocus && !notebookOutputInputFocused"
	},
	// NOTE: Toggle line numbers, outputs and inputs.
	{
		"key": "l",
		"command": "-notebook.cell.toggleLineNumbers",
		"when": "notebookEditorFocused && !inputFocus && !notebookOutputInputFocused"
	},
	{
		"key": "l",
		"command": "notebook.toggleLineNumbers",
		"when": "notebookEditorFocused && !inputFocus && !notebookOutputInputFocused"
	},
	{
		"key": "shift+l",
		"command": "-notebook.toggleLineNumbers",
		"when": "notebookEditorFocused && !inputFocus && !notebookOutputInputFocused"
	},
	{
		"key": "o",
		"command": "-list.toggleExpand",
		"when": "listFocus && !inputFocus"
	},
	{
		"key": "o",
		"command": "notebook.cell.toggleOutputs",
		"when": "notebookEditorFocused && !inputFocus && !notebookOutputInputFocused"
	},
	{
		"key": "i",
		"command": "notebook.cell.collapseCellInput",
		"when": "notebookEditorFocused && !inputFocus && !notebookCellInputIsCollapsed"
	},
	{
		"key": "i",
		"command": "notebook.cell.expandCellInput",
		"when": "notebookEditorFocused && !inputFocus && notebookCellInputIsCollapsed"
	},
	// NOTE: Nvim commands for copying, pasting and selecting.
	{
		"key": "u",
		"command": "undo",
		"when": "notebookEditorFocused && !inputFocus && !notebookOutputInputFocused"
	},
	{
		"key": "z",
		"command": "-undo",
		"when": "notebookEditorFocused && !inputFocus && !notebookOutputInputFocused"
	},
	{
		"key": "p",
		"command": "notebook.cell.paste",
		"when": "notebookEditorFocused && !inputFocus && !notebookOutputInputFocused"
	},
	{
		"key": "v",
		"command": "-notebook.cell.paste",
		"when": "notebookEditorFocused && !inputFocus && !notebookOutputInputFocused"
	},
	{
		"key": "y o",
		"command": "notebook.cell.copyOutput",
		"when": "notebookEditorFocused && !inputFocus && !notebookOutputInputFocused"
	},
	{
		"key": "y y",
		"command": "notebook.cell.copy",
		"when": "notebookEditorFocused && !inputFocus && !notebookOutputInputFocused"
	},
	{
		"key": "c",
		"command": "-notebook.cell.copy",
		"when": "notebookEditorFocused && !inputFocus && !notebookOutputInputFocused"
	},
	// NOTE: v for extending selection down, V for extending selection up. (Ctrl + A selects all cells)
	{
		"key": "v",
		"command": "list.expandSelectionDown",
		"when": "listFocus && listSupportsMultiselect && !inputFocus && !treestickyScrollFocused"
	},
	{
		"key": "shift+v",
		"command": "list.expandSelectionUp",
		"when": "listFocus && listSupportsMultiselect && !inputFocus && !treestickyScrollFocused"
	},
	// Convert to Markdown cell
	{
		"key": "m",
		"command": "notebook.cell.changeToMarkdown",
		"when": "notebookEditorFocused && !inputFocus"
	},
	// Convert to Code cell
	{
		"key": "c",
		"command": "notebook.cell.changeToCode",
		"when": "notebookEditorFocused && !inputFocus"
	},
	// ============================================
	// CHAPTER: Ctrl + key
	// ============================================
	// ctrl + y for accepting
	{
		"key": "ctrl+y",
		"command": "-redo"
	},
	{
		"key": "ctrl+y",
		"command": "acceptSelectedSuggestion",
		"when": "acceptSuggestionOnEnter && suggestWidgetHasFocusedSuggestion && suggestWidgetVisible && suggestionMakesTextEdit && textInputFocus"
	},
	// ctrl + i for jumping backwards jump list
	{
		"key": "ctrl+i",
		"command": "-inlineChat2.reveal",
		"when": "inlineChatHasEditsAgent && !chatEdits.isGlobalEditingSession && chatEdits.requestCount >= 1"
	},
	{
		"key": "ctrl+i",
		"command": "-inlineChat.start",
		"when": "editorFocus && inlineChatHasEditsAgent && inlineChatPossible && !editorReadonly && !editorSimpleInput || editorFocus && inlineChatHasProvider && inlineChatPossible && !editorReadonly && !editorSimpleInput"
	},
	{
		"key": "ctrl+i",
		"command": "-inlineChat.startWithCurrentLine",
		"when": "inlineChatHasProvider && inlineChatShowingHint && !editorReadonly && !inlineChatVisible"
	},
	// ctrl + e is just misleading
	{
		"key": "ctrl+e",
		"command": "-workbench.action.quickOpen"
	},
	{
		"key": "ctrl+e",
		"command": "-vscode-neovim.ctrl-e",
		"when": "editorTextFocus && neovim.ctrlKeysNormal.e && neovim.init && neovim.mode != 'insert' && editorLangId not in 'neovim.editorLangIdExclusions'"
	},
	{
		"key": "ctrl+e",
		"command": "-vscode-neovim.send",
		"when": "editorTextFocus && neovim.ctrlKeysInsert.e && neovim.init && neovim.mode == 'insert' && editorLangId not in 'neovim.editorLangIdExclusions'"
	},
	// ctrl + x
	{
		"key": "ctrl+x",
		"command": "-vscode-neovim.send",
		"when": "editorTextFocus && neovim.ctrlKeysNormal.x && neovim.init && neovim.mode != 'insert' && editorLangId not in 'neovim.editorLangIdExclusions'"
	},
	{
		"key": "ctrl+x",
		"command": "-vscode-neovim.send",
		"when": "editorTextFocus && neovim.ctrlKeysInsert.x && neovim.init && neovim.mode == 'insert' && editorLangId not in 'neovim.editorLangIdExclusions'"
	},
	{
		"key": "ctrl+z",
		"command": "-vscode-neovim.send",
		"when": "editorTextFocus && neovim.ctrlKeysInsert.z && neovim.init && neovim.mode == 'insert' && editorLangId not in 'neovim.editorLangIdExclusions'"
	},
	{
		"key": "ctrl+z",
		"command": "-vscode-neovim.send",
		"when": "editorTextFocus && neovim.ctrlKeysNormal.z && neovim.init && neovim.mode != 'insert' && editorLangId not in 'neovim.editorLangIdExclusions'"
	},
	{
		"key": "ctrl+k",
		"command": "-vscode-neovim.send",
		"when": "editorTextFocus && neovim.ctrlKeysInsert.k && neovim.init && neovim.mode == 'insert' && editorLangId not in 'neovim.editorLangIdExclusions'"
	},
	{
		"key": "ctrl+k",
		"command": "-vscode-neovim.send",
		"when": "editorTextFocus && neovim.ctrlKeysNormal.k && neovim.init && neovim.mode != 'insert' && editorLangId not in 'neovim.editorLangIdExclusions'"
	},
	{
		"key": "ctrl+s",
		"command": "-vscode-neovim.send",
		"when": "editorTextFocus && neovim.ctrlKeysNormal.s && neovim.init && neovim.mode != 'insert' && editorLangId not in 'neovim.editorLangIdExclusions'"
	},
	{
		"key": "ctrl+s",
		"command": "-vscode-neovim.send",
		"when": "editorTextFocus && neovim.ctrlKeysInsert.s && neovim.init && neovim.mode == 'insert' && editorLangId not in 'neovim.editorLangIdExclusions'"
	},
	{
		"key": "ctrl+a",
		"command": "-vscode-neovim.send",
		"when": "editorTextFocus && neovim.ctrlKeysNormal.a && neovim.init && neovim.mode != 'insert' && editorLangId not in 'neovim.editorLangIdExclusions'"
	},
	{
		"key": "ctrl+a",
		"command": "-vscode-neovim.send",
		"when": "editorTextFocus && neovim.ctrlKeysInsert.a && neovim.init && neovim.mode == 'insert' && editorLangId not in 'neovim.editorLangIdExclusions'"
	},
	{
		"key": "ctrl+g",
		"command": "-vscode-neovim.send-cmdline",
		"when": "neovim.init && neovim.mode == 'cmdline'"
	},
	{
		"key": "ctrl+g",
		"command": "-vscode-neovim.send",
		"when": "editorTextFocus && neovim.ctrlKeysNormal.g && neovim.init && neovim.mode != 'insert' && editorLangId not in 'neovim.editorLangIdExclusions'"
	},
	{
		"key": "ctrl+g",
		"command": "-vscode-neovim.send",
		"when": "editorTextFocus && neovim.ctrlKeysInsert.g && neovim.init && neovim.mode == 'insert' && editorLangId not in 'neovim.editorLangIdExclusions'"
	}
]
