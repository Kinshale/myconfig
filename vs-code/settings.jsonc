{
	"extensions.experimental.affinity": {
		"asvetliakov.vscode-neovim": 1
	},
	"vscode-neovim.neovimInitVimPaths.linux": "~/myconfig/vs-code/vscode_init.lua",
	"keyboard.dispatch": "keyCode",
	"vscode-neovim.neovimUseSystemClipboard": true,
	"editor.fontLigatures": true,
	"terminal.integrated.inheritEnv": false,
	"mdb.mcp.server": "autoStartDisabled",
	"editor.stickyScroll.enabled": false,
	"editor.minimap.enabled": false,
	"window.menuBarVisibility": "compact",
	"notebook.outline.showCodeCellSymbols": false,
	"notebook.outline.showMarkdownHeadersOnly": false,
	"breadcrumbs.enabled": false,
	"workbench.statusBar.visible": false,
	"github.copilot.enable": {
		"*": false,
		"plaintext": false,
		"markdown": false,
		"scminput": false
	},
	"github.copilot.nextEditSuggestions.enabled": true, // FIX: Is it necessary?
	"explorer.confirmDragAndDrop": false,
	"typescript.updateImportsOnFileMove.enabled": "always",
	"git.blame.editorDecoration.enabled": false,
	"python.defaultInterpreterPath": "/home/ale/micromamba/envs/jax-notebook/bin/python",
	"[python]": {
		"editor.defaultFormatter": "ms-python.black-formatter"
	}
}
